{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supply-requisition",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "account_id": "17abb4914aa1cbfcf03edddedbaea672",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["0 1 * * *"] },
  "vars": { "DRIVE_ROOT_FOLDER_ID": "1kVDobdN0V1U7bqTHHFMEDrlUEhQAMG4U" },
  "ratelimits": [
    { "name": "GUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      // Verify database_name against the Cloudflare dashboard before any --remote command.
      "database_name": "ims_db",
      "database_id": "4c98cc16-6008-4880-9d38-99544c79b838",
      "migrations_dir": "migrations"
    }
  ]
}
